 "cards": [
  {
   "dot": "cyan",
   "title": "How to read it",
   "items": [
    "Solid lines are real foreign keys; dashed lines join by id with no FK (the queue tables stay independent so rows can be purged or archived alone)",
    "Spring's IDs (facility, borrower, covenant, CP) arrive in dps_job.request_json and go back in dps_run.result_json; DPS keeps cp_id only where it learns per counterparty",
    "Created by Alembic migrations in dps/migrations/versions; models in dps/src/dps/models.py"
   ]
  },
  {
   "dot": "violet",
   "title": "Main path",
   "items": [
    "POST /dps/v1/jobs writes dps_job (+ dps_document) and a dps_event_feed row",
    "The worker claims dps_job, logs dps_job_attempt, writes page models to dps_artifact",
    "The result is saved as dps_run.result_json (dps.result/1.0) with its event; reviewer actions go to dps_review_decision"
   ]
  }
 ]
}