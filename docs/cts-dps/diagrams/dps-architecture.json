  "cards": [
    { "dot": "cyan", "title": "Main path (Miro onboarding board)", "items": [
      "Spring submits POST /dps/v1/jobs; a duplicate returns the running job (extraction in progress)",
      "The worker claims the job with a lease, reads the file by version and SHA-256, parses it in a sandbox",
      "A CrewAI Flow runs the skill: classify, rules, page finder, 4 agent reads, ledger, Java check, codes, score",
      "The result is saved with its event; Spring pulls it and a person approves" ] },
    { "dot": "violet", "title": "One agent, many skills", "items": [
      "Skill packs: dps/src/dps/skills/<name>/ (pack.yaml, prompt.md, schema.json, rules.py)",
      "Tools: page_text, search_text, find_definition, covenant_library, validate_formula, lookup_identifier",
      "Every answer must quote its page (dps/src/dps/skills/common.py grounded) or it is dropped" ] },
    { "dot": "rose", "title": "Safety and trust", "items": [
      "Parsing runs in a child process with CPU, memory and time limits and no network",
      "Only selected page text goes to the bank's Azure endpoint, through the gateway's allow-list",
      "DPS never decides compliance; every high-risk field goes to a person" ] },
    { "dot": "amber", "title": "Java wrap", "items": [
      "Business rules stay in Spring (one rule engine); DPS calls them as batched tools",
      "If Spring is down the field gets SPRING_UNAVAILABLE and goes to review; the job carries on" ] }
  ]
