  subgraph DPS["DPS runtime"]
    API["FastAPI ×2"]
    WORKER["Workers<br/>3 Standard · 1 Heavy"]
    PARSER["Parser sidecars ×4<br/>Native text · OCR"]
    PAGE["Page model<br/>Build · reuse"]
    SKILL["Skill router<br/>Job type · classifier"]
    EXTRACT["Extraction<br/>Skill packs · rules"]
    AGENT["Document Agent<br/>CrewAI · skill tools"]
    GATE["AI gateway<br/>Routes · limits"]
    VERIFY["Validation<br/>Schema · evidence"]
  end

  subgraph DATA["DPS persistence"]
    SQL[("MySQL · cov_monitoring<br/>Jobs · results · review · events")]
    DERIVED[("Derived files<br/>Page models · previews")]
  end

  AZURE["Azure OpenAI<br/>Small · strong · vision"]

  SPRING <-->|Jobs · results · review| API
  API <-->|Read / write| SQL
  SQL -->|Lease| WORKER
  FILES -->|File bytes| WORKER
  WORKER --> PARSER
  PARSER --> PAGE
  PAGE <-->|Load / save| DERIVED
  PAGE --> SKILL --> EXTRACT
  EXTRACT <--> AGENT
  AGENT <--> GATE <--> AZURE
  EXTRACT --> VERIFY

  VERIFY -->|Result revision| SQL

