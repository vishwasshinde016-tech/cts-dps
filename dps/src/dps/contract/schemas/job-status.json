{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cts.local/dps/schemas/job-status.json",
  "title": "dps.job-status/1.0",
  "description": "GET /dps/v1/jobs/{jobId}. The job's status, attempts and steps, with its result link once there is one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "jobType", "status", "priority", "attempts", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "jobType": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "RETRY_WAIT", "NEEDS_REVIEW", "DONE", "FAILED", "DEAD", "CANCELLED"]
    },
    "priority": { "type": "string", "enum": ["INTERACTIVE", "AMENDMENT", "ASSESSMENT", "BULK", "REPROCESS"] },
    "tenantId": { "type": "string" },
    "documentId": { "type": ["string", "null"] },
    "documentVersionId": { "type": ["string", "null"] },
    "batchId": { "type": ["string", "null"] },
    "correlationId": { "type": ["string", "null"] },
    "pool": { "type": "string" },
    "attempts": { "type": "integer", "minimum": 0 },
    "stage": { "type": ["string", "null"], "description": "The stage running now or last run." },
    "cancelRequested": { "type": "boolean" },
    "error": { "type": ["string", "null"], "description": "What went wrong, for support" },
    "errorCode": { "type": ["string", "null"], "description": "A code from catalogues/errors.yaml" },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "dueAt": { "type": ["string", "null"], "format": "date-time" },
    "resultUrl": { "type": ["string", "null"] },
    "flow": { "type": "string", "description": "SKILL_PACK (every reading job) or ANALYZE" },
    "currentStep": { "type": ["string", "null"], "description": "The last step recorded (same as stage)." },
    "steps": {
      "type": "array",
      "description": "Every step recorded, in order: {step, at, ...} with the attempt, worker or error code.",
      "items": { "type": "object", "required": ["step", "at"], "properties": { "step": { "type": "string" }, "at": { "type": "string" } } }
    },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "fileName": { "type": ["string", "null"], "description": "GET /dps/v1/jobs only: the uploaded file's name." },
    "cpIds": { "type": "array", "items": { "type": "string" }, "description": "GET /dps/v1/jobs only: the CPs it is linked to." },
    "revision": { "type": "integer", "minimum": 1, "description": "POST .../review only: the run number just saved." },
    "remaining": { "type": "integer", "minimum": 0, "description": "POST .../review only: fields still to review." }
  }
}
