{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cts.local/dps/schemas/review-decisions.json",
  "title": "dps.review-decisions/1.0",
  "description": "POST /dps/v1/jobs/{jobId}/review (phase 5) with If-Match: <revision>. The reviewer is the acting user the Spring app passes (X-User or a token claim).",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fieldId", "action"],
        "properties": {
          "fieldId": { "type": "string", "description": "Required for CONFIRM, CORRECT and REJECT; for ADD, a client-chosen id" },
          "action": { "type": "string", "enum": ["CONFIRM", "CORRECT", "REJECT", "ADD", "ACKNOWLEDGE"], "description": "ACKNOWLEDGE: fieldId is warning:<CODE> of a blocking warning; comment required" },
          "group": { "type": "string", "description": "Required for ADD" },
          "name": { "type": "string", "description": "Required for ADD" },
          "value": { "description": "Required for CORRECT and ADD; typed as in result.json for the group" },
          "page": { "type": ["integer", "null"], "minimum": 1, "description": "Required for ADD" },
          "reasonCode": { "type": "string", "enum": ["WRONG_VALUE", "WRONG_UNIT", "WRONG_PAGE", "NOT_A_COVENANT", "MISSED", "OTHER"] },
          "comment": { "type": ["string", "null"], "maxLength": 2000 }
        },
        "allOf": [
          { "if": { "properties": { "action": { "enum": ["CORRECT", "ADD"] } } }, "then": { "required": ["value", "reasonCode"] } },
          { "if": { "properties": { "action": { "const": "ADD" } } }, "then": { "required": ["group", "name", "page"] } },
          { "if": { "properties": { "action": { "const": "ACKNOWLEDGE" } } }, "then": { "required": ["comment"] } }
        ]
      }
    }
  }
}
