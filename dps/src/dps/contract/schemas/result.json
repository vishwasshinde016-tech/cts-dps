{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cts.local/dps/schemas/result.json",
  "title": "dps.result/1.0",
  "description": "GET /dps/v1/jobs/{jobId}/result: one run's result. Every field cites its source; unknown values are null with an issue, never invented. Fields marked 'phase 3+' are optional until those phases.",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "jobId",
    "jobType",
    "status",
    "fields",
    "document",
    "pipeline"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "page",
        "quote"
      ],
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x0, y0, x1, y1] in PDF points, origin top-left (phase 2+)"
        },
        "blockId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cellRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sheet!A1 reference for spreadsheets"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "acknowledged": {
          "type": "object",
          "description": "A blocking warning a reviewer accepted with a reason (ACKNOWLEDGE decision)",
          "properties": {"by": {"type": "string"}, "comment": {"type": "string"}}
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "group",
        "name",
        "value",
        "source",
        "method",
        "confidence",
        "issues",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "enum": [
            "FINANCIAL_COVENANT",
            "NON_FINANCIAL_COVENANT",
            "INFO_COVENANT",
            "POSSIBLE_COVENANT",
            "AGREEMENT_TERM",
            "SCHEDULE_TERM",
            "STATEMENT_LINE",
            "CERTIFIED_FIGURE",
            "IDENTIFIER",
            "EVENT_OF_DEFAULT",
            "WAIVER"
          ]
        },
        "name": {
          "type": "string"
        },
        "value": {
          "description": "Typed by group; see the if/then rules below and $defs/*Value."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "test": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "frequency": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "STANDALONE",
                "CONSOLIDATED",
                null
              ]
            },
            "firstTestDate": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "holiday": {
              "type": [
                "object",
                "null"
              ],
              "description": "WP6: testing starts later ('shall not be tested until 30 June 2026'): {until, text}",
              "properties": {
                "until": {"type": ["string", "null"], "format": "date"},
                "text": {"type": "string"}
              }
            }
          }
        },
        "libraryMatch": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "covenantMasterId": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": { "type": ["string", "null"], "description": "The library covenant's name" },
            "candidates": {
              "type": "array",
              "description": "When several library covenants fit equally (two masters on the same measure): the choices, for a person (LIBRARY_AMBIGUOUS); covenantMasterId is then null",
              "items": { "type": "object", "properties": { "covenantMasterId": { "type": "string" }, "name": { "type": ["string", "null"] } } }
            },
            "expression": {
              "type": [
                "string",
                "null"
              ],
              "description": "The library covenant's own (master) condition, for comparison only. The document's condition is value.expression"
            }
          }
        },
        "method": {
          "type": "string",
          "examples": [
            "RULES",
            "AI",
            "RULES+AI_CONFIRMED",
            "MANUAL",
            "AI_VISION"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "null until the phase 5 scorer when the pipeline has no score"
        },
        "signals": {
          "type": [
            "object",
            "null"
          ],
          "description": "phase 5: inputs to the calibrated score"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "AUTO_ACCEPTED",
            "NEEDS_REVIEW",
            "REJECTED",
            "CONFIRMED",
            "CORRECTED",
            "NOT_USED"
          ],
          "description": "NOT_USED: left undecided when the caller closed the review (POST /dps/v1/jobs/{jobId}/close); not a person's verdict"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "group": {
                "enum": [
                  "FINANCIAL_COVENANT",
                  "NON_FINANCIAL_COVENANT",
                  "INFO_COVENANT",
                  "POSSIBLE_COVENANT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/covenantValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "group": {
                "const": "STATEMENT_LINE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/statementLineValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "group": {
                "const": "SCHEDULE_TERM"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/scheduleTermValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "group": {
                "const": "CERTIFIED_FIGURE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/certifiedFigureValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "group": {
                "const": "AGREEMENT_TERM"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/agreementTermValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "group": {
                "const": "IDENTIFIER"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/identifierValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "group": {
                "const": "EVENT_OF_DEFAULT"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/eventOfDefaultValue"
              }
            }
          }
        },
        {
          "if": {"properties": {"group": {"const": "WAIVER"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/waiverValue"}}}
        }
      ]
    },
    "eventOfDefaultValue": {
      "type": "object",
      "required": [
        "code",
        "category"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Event-of-default taxonomy code (EOD_NON_PAYMENT, EOD_COVENANT_BREACH ...; EOD_OTHER)"
        },
        "category": {
          "const": "event_of_default"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "cureDays": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "covenantValue": {
      "type": "object",
      "required": [
        "metric",
        "operator",
        "threshold",
        "unit",
        "expression"
      ],
      "properties": {
        "covers": { "type": "array", "items": { "type": "string" }, "description": "Other duty sentences of the same kind near this covenant that it is taken to cover (candidate ledger); shown so a person sees each one" },
        "qualifiers": { "type": "array", "items": { "type": "string" }, "description": "Conditions and exceptions found with the covenant (subject to, unless, provided that ...)" },
        "references": { "type": "array", "items": { "type": "object", "properties": { "ref": { "type": "string" }, "page": { "type": ["integer", "null"] } } } },
        "metric": {
          "type": "string",
          "description": "Metric key as read (DSCR, ICR, DEBT_TO_EBITDA ...)"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "description": "Covenant taxonomy code (FIN_DSCR, NEG_LIENS ...); null when the taxonomy has none"
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "financial",
            "affirmative",
            "negative",
            "reporting",
            "event_of_default",
            null
          ]
        },
        "suggested": {
          "type": "object",
          "description": "What the document does not state, as the covenant taxonomy usually has it: a suggestion for the reviewer, never written into the field (TAXONOMY_DEFAULT)",
          "properties": { "operator": { "type": "string" }, "unit": { "type": "string" }, "frequency": { "type": "string" } }
        },
        "defaults": {
          "type": "array",
          "items": {
            "enum": [
              "operator",
              "unit",
              "frequency"
            ]
          },
          "description": "Deprecated (results before 19 Nov 2026): values filled from the taxonomy. New results leave them empty and use suggested"
        },
        "operator": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            ">=",
            ">",
            "<=",
            "<",
            "=",
            null
          ]
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "RATIO",
            "PERCENT",
            "INR_CR",
            "TIMES"
          ]
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of an amount covenant (minimum net worth, EBITDA floor), from the symbol or code next to the amount ('£5,000,000' gives GBP); absent when the text names none"
        },
        "expression": {
          "type": [
            "string",
            "null"
          ],
          "description": "The document's covenant as a condition in the bank app's formula language: MEASURE OP NUMBER with the app's measure code (from the library match), the document's operator and threshold, '==' for equality, plain decimals, amounts in INR crore, percentages as points. Null when it cannot be written (see mapping.reasons)"
        },
        "mapping": {
          "type": "object",
          "description": "Whether expression is the whole covenant. mappable false: apply it only after a person has read the reasons (a condition, a qualifier, another obligor, a step-down, an amount in another currency, a formula the app refused)",
          "properties": {
            "mappable": { "type": "boolean" },
            "reasons": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "array", "items": { "type": "string" } },
            "measure": { "type": ["string", "null"], "description": "The measure code used in expression" },
            "unit": { "type": ["string", "null"], "description": "INR_CR when an amount was converted to INR crore" }
          }
        },
        "schedule": {
          "type": [
            "array",
            "object",
            "null"
          ],
          "description": "Step-downs: the threshold by period (phase 4 adds [{from, to, threshold}]); null when flat"
        },
        "change": {
          "type": [
            "object",
            "null"
          ],
          "description": "EXTRACT_AMENDMENT: what the amendment does to this covenant",
          "properties": {
            "type": {
              "enum": [
                "ADD",
                "CHANGE",
                "DELETE"
              ]
            },
            "clause": {
              "type": [
                "string",
                "null"
              ]
            },
            "effectiveDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "from": {
              "type": [
                "object",
                "null"
              ]
            },
            "appliedCovenantId": {
              "type": [
                "string",
                "null"
              ],
              "description": "The approved CTS covenant this change touches (G2)"
            },
            "explanation": {
              "type": [
                "string",
                "null"
              ],
              "description": "The Document Agent's one-line explanation of the change (text only; never a value)"
            },
            "explanationBy": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "AI",
                null
              ]
            }
          }
        },
        "cure": {
          "type": [
            "object",
            "null"
          ],
          "description": "Cure right: days and whether an equity cure is allowed"
        },
        "appliedCovenantId": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "object",
          "description": "WP6 (F4): who the covenant binds and on whose figures it is tested. obligor as written (Borrower, Guarantor, Parent, Group ...); confidence STATED (the quote says it), INFERRED (the Document Agent or the job context) or UNKNOWN. An UNKNOWN financial covenant, or one that binds several companies, is always reviewed",
          "required": ["obligor", "basis", "facilityRefs", "confidence"],
          "properties": {
            "obligor": {"type": ["string", "null"]},
            "basis": {"type": ["string", "null"], "enum": ["STANDALONE", "CONSOLIDATED", null]},
            "facilityRefs": {"type": "array", "items": {"type": "string"}},
            "confidence": {"enum": ["STATED", "INFERRED", "UNKNOWN"]}
          }
        },
        "conditions": {
          "type": "array",
          "description": "WP6 (F3): the 'if / when / so long as' triggers. SPRINGING: tested only while loans are drawn or availability is low. A condition always means review",
          "items": {
            "type": "object",
            "required": ["text", "kind"],
            "properties": {
              "text": {"type": "string"},
              "kind": {"enum": ["SPRINGING", "RATING", "CONDITIONAL"]},
              "metric": {"type": ["string", "null"]},
              "operator": {"type": ["string", "null"], "enum": [">=", ">", "<=", "<", "=", null]},
              "threshold": {"type": ["number", "null"]},
              "unit": {"type": ["string", "null"]}
            }
          }
        },
        "baskets": {
          "type": "array",
          "description": "WP6: permitted amounts of a negative covenant ('not exceeding USD 5,000,000 in aggregate')",
          "items": {
            "type": "object",
            "properties": {
              "text": {"type": "string"},
              "amount": {"type": ["number", "null"]},
              "currency": {"type": ["string", "null"]}
            }
          }
        },
        "inForce": {
          "type": "object",
          "description": "RECONCILE_SET (WP9): this covenant in force at asOfDate, with the documents that set or changed it (trail) and the waivers attached to it",
          "properties": {
            "asOfDate": {"type": "string", "format": "date"},
            "waivedAtDate": {"type": "boolean"},
            "sourceFieldId": {"type": ["string", "null"]},
            "trail": {"type": "array", "items": {"type": "object", "properties": {
              "versionId": {"type": "string"}, "role": {"type": "string"},
              "action": {"enum": ["APPROVED", "SET", "RESTATED", "ADDED", "CHANGED", "WAIVED"]},
              "effectiveDate": {"type": ["string", "null"]}, "fieldId": {"type": ["string", "null"]}}}},
            "waivers": {"type": "array", "items": {"type": "object"}}
          }
        },
        "equityCure": {
          "type": ["object", "null"],
          "description": "WP6: the agreement's equity cure right, on each financial covenant",
          "properties": {
            "allowed": {"type": "boolean"},
            "maxUses": {"type": ["integer", "null"]},
            "window": {"type": ["string", "null"]},
            "page": {"type": ["integer", "null"]},
            "text": {"type": "string"}
          }
        }
      }
    },
    "waiverValue": {
      "type": "object",
      "description": "WP9 (F10): what a waiver or consent letter waives. Always reviewed",
      "required": ["kind", "target", "periods", "conditions", "expiresOn"],
      "properties": {
        "kind": {"enum": ["WAIVER", "CONSENT", "NOT_TESTED", "EXTENSION"], "description": "EXTENSION: a date or time limit moved to extendedTo"},
        "extendedTo": {"type": ["string", "null"], "format": "date", "description": "EXTENSION only: the new date"},
        "target": {
          "type": "object",
          "properties": {
            "metric": {"type": ["string", "null"]},
            "clause": {"type": ["string", "null"]},
            "appliedCovenantId": {"type": ["string", "null"], "description": "The approved CTS covenant waived"},
            "name": {"type": ["string", "null"]}
          }
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {"type": ["string", "null"], "format": "date"},
              "to": {"type": ["string", "null"], "format": "date"},
              "testDate": {"type": ["string", "null"], "format": "date"}
            }
          }
        },
        "conditions": {"type": "array", "items": {"type": "string"}},
        "expiresOn": {"type": ["string", "null"], "format": "date"},
        "reinstatement": {"type": ["string", "null"]},
        "fee": {"type": ["object", "null"]},
        "metric": {"type": ["string", "null"]},
        "code": {"type": ["string", "null"]}
      }
    },
    "statementLineValue": {
      "type": "object",
      "required": [
        "amount",
        "unit",
        "asOfDate"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "description": "As normalised, e.g. INR_CR"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "scale": {
          "type": [
            "string",
            "null"
          ],
          "description": "As printed: THOUSAND, LAKH, CRORE, MILLION (phase 4)"
        },
        "asOfDate": {
          "type": "string",
          "format": "date"
        },
        "periodMonths": {
          "type": [
            "integer",
            "null"
          ]
        },
        "derived": {
          "type": "boolean",
          "description": "Computed from other lines, not printed"
        }
      }
    },
    "scheduleTermValue": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "TESTING_CALENDAR",
            "REPORTING_DEADLINE",
            "REPAYMENT",
            "INTEREST_RESET",
            "CURE_WINDOW",
            "OTHER"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "The rule in words, as the clause says"
        },
        "frequency": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "MONTHLY",
            "QUARTERLY",
            "HALF_YEARLY",
            "YEARLY",
            null
          ]
        },
        "appFrequency": {
          "type": ["string", "null"],
          "enum": ["MONTHLY", "QUARTERLY", "YEARLY", "CUSTOM", null],
          "description": "The bank app's Frequency for this term. HALF_YEARLY has no value of its own there: it is CUSTOM with appCron"
        },
        "appCron": {
          "type": ["string", "null"],
          "description": "With appFrequency CUSTOM: the app's cron for the term (HALF_YEARLY: 0 0 2 1 1,7 ?, the 1st of January and July)"
        },
        "deliverable": {
          "type": ["string", "null"],
          "enum": ["COMPLIANCE_CERTIFICATE", "AUDITED_FINANCIAL_STATEMENTS", "INTERIM_FINANCIAL_STATEMENTS", "FINANCIAL_STATEMENTS", "STOCK_STATEMENT", "INSURANCE", null],
          "description": "REPORTING_DEADLINE: what is to be delivered, as the clause says; null when it names none DPS knows"
        },
        "covenantIds": {
          "type": "array",
          "items": {"type": "string"},
          "description": "REPORTING_DEADLINE for statements or a compliance certificate: the ids of this result's financial covenants tested at the same frequency (empty when none or when the frequency is unknown)"
        },
        "daysAfterPeriodEnd": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "certifiedFigureValue": {
      "type": "object",
      "required": [
        "covenant",
        "figure"
      ],
      "properties": {
        "covenant": {
          "type": "string"
        },
        "figure": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "declaredCompliant": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signatory": {
          "type": [
            "string",
            "null"
          ]
        },
        "designation": {
          "type": [
            "string",
            "null"
          ]
        },
        "signedOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "udin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-Z]{18}$"
        }
      }
    },
    "agreementTermValue": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "examples": [
            "SANCTIONED_AMOUNT",
            "TENOR_MONTHS",
            "INTEREST_RATE",
            "FACILITY_TYPE",
            "EFFECTIVE_DATE",
            "AMENDMENT_PROVISION",
            "AMENDMENT_ALLOCATION"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "amendmentItem": {
          "type": "string",
          "description": "The numbered source item for a reviewable amendment provision or funding allocation."
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "identifierValue": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifierKind"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "identifierKind": {
      "type": "string",
      "enum": [
        "FACILITY_ID",
        "LOAN_ACCOUNT",
        "CIN",
        "PAN",
        "GSTIN",
        "LEI",
        "UDIN",
        "BORROWER_NAME",
        "PERIOD_END",
        "CURRENCY",
        "UNIT",
        "SIGNATURE",
        "ISSUER"
      ]
    },
    "identifier": {
      "type": "object",
      "required": [
        "kind",
        "value",
        "source",
        "match"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifierKind"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "match": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "EXACT",
                "STRONG",
                "FUZZY",
                "CONFLICT",
                "NONE"
              ]
            },
            "candidateIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "LENDER",
            "BANK",
            "AUDITOR",
            "AGENT",
            null
          ],
          "description": "For ISSUER: who issued the document (G3)"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "const": "dps.result/1.0"
    },
    "runId": {
      "type": "string"
    },
    "jobId": {
      "type": "string"
    },
    "jobType": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "NEEDS_REVIEW",
        "FAILED"
      ]
    },
    "documentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "documentVersionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "pipeline": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "skillPack": {
          "type": [
            "string",
            "null"
          ]
        },
        "taxonomyVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "Covenant taxonomy version the codes come from (2026.11.0+dps.1)"
        },
        "models": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "modelPins": {
          "type": ["object", "null"],
          "description": "Per route used: what the model calls were pinned to (deployment, Azure apiVersion, maxTokens, timeoutSeconds, temperature; null temperature = the model's default)",
          "additionalProperties": {"type": "object"}
        },
        "packs": {
          "type": ["object", "null"],
          "description": "Each skill pack and prompt that could reach the model for this result: version and promptSha (pack prompts, covenant parts, residual read, document-type check)",
          "additionalProperties": {"type": "object"}
        }
      }
    },
    "classification": {
      "type": [
        "object",
        "null"
      ],
      "description": "phase 3+",
      "required": [
        "type",
        "confidence"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SANCTION_LETTER",
            "LOAN_AGREEMENT",
            "AMENDMENT",
            "FINANCIAL_STATEMENT",
            "COMPLIANCE_CERTIFICATE",
            "SECURITY_DOCUMENT",
            "OTHER_EVIDENCE",
            "WAIVER_CONSENT",
            "GUARANTEE",
            "AMENDED_AND_RESTATED",
            "TRUST_DEED",
            "UNKNOWN"
          ]
        },
        "expected": {
          "type": [
            "string",
            "null"
          ]
        },
        "mismatch": {
          "type": "boolean"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "STANDALONE",
            "CONSOLIDATED",
            null
          ]
        },
        "periodType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ANNUAL",
            "HALF_YEARLY",
            "QUARTERLY",
            "MONTHLY",
            null
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "RULES",
            "RULES+AI_CONFIRMED",
            "MODEL",
            "VISION",
            null
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "evidenceKind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "STOCK_STATEMENT",
            "INSURANCE",
            "VALUATION",
            "RATING",
            null
          ]
        },
        "aiSecondOpinion": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Document Agent's different type (the rules decided; the job goes to a person)"
        }
      }
    },
    "identifiers": {
      "type": "array",
      "description": "phase 3+",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "document": {
      "type": "object",
      "required": [
        "route"
      ],
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "route": {
          "type": "string",
          "enum": [
            "AUTO_ACCEPTED",
            "REVIEWED",
            "NEEDS_REVIEW",
            "MAPPING_REVIEW",
            "REJECTED",
            "FAILED",
            "CLOSED",
            "SUPERSEDED"
          ],
          "description": "CLOSED: the caller closed the review (fields left undecided are NOT_USED); SUPERSEDED: read again as another type (the new job carries the result). MAPPING_REVIEW: a mapping problem (wrong entity, wrong type, identifiers of another borrower); the job status is still NEEDS_REVIEW"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "object",
          "description": "Covenant jobs: every covenant-shaped sentence of the whole document and how it was settled (found by a field, covered by a covenant of the same kind, not a covenant with a reason, or unresolved and listed as a review item)",
          "properties": {
            "dutySentences": { "type": "integer" },
            "explained": { "type": "integer" },
            "byQuote": { "type": "integer", "description": "explained because a field quotes the sentence" },
            "byKind": { "type": "integer", "description": "explained by a covenant of the same kind on the page or a neighbour" },
            "percent": { "type": "number" },
            "unexplainedCount": { "type": "integer" },
            "unexplained": {
              "type": "array",
              "items": { "type": "object", "properties": { "page": { "type": "integer" }, "text": { "type": "string" }, "kind": { "type": ["string", "null"] } } }
            },
            "ledger": {
              "type": "object",
              "description": "The candidate ledger: every candidate has exactly one state, so accounted equals candidates",
              "properties": {
                "scope": { "type": "string", "enum": ["WHOLE_DOCUMENT"] },
                "pages": { "type": "integer" },
                "candidates": { "type": "integer" },
                "accounted": { "type": "integer" },
                "finding": { "type": "integer" },
                "covered": { "type": "integer" },
                "notCovenant": { "type": "integer" },
                "unresolved": { "type": "integer" },
                "percentExplained": { "type": "number" },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "page", "state"],
                    "properties": {
                      "id": { "type": "string" },
                      "page": { "type": "integer" },
                      "route": { "type": "string", "enum": ["DUTY", "CUE", "LEXICON", "CROSS_DEFAULT", "TABLE"], "description": "Why the sentence is in the ledger: DUTY (shall, must), CUE (a borrower duty word), LEXICON (may not, no member of the Group may), CROSS_DEFAULT, TABLE (a lead-in with a table of levels)" },
                      "kind": { "type": ["string", "null"] },
                      "state": { "type": "string", "enum": ["FINDING", "COVERED", "NOT_A_COVENANT", "UNRESOLVED"] },
                      "reason": { "type": ["string", "null"] },
                      "fieldId": { "type": ["string", "null"] },
                      "text": { "type": "string" },
                      "qualifiers": { "type": "array", "items": { "type": "string" } },
                      "references": { "type": "array", "items": { "type": "object", "properties": { "ref": { "type": "string" }, "page": { "type": ["integer", "null"] } } } }
                    }
                  }
                }
              }
            }
          }
        },
        "lines": {
          "type": "object",
          "description": "Statements: the catalogue period lines expected, found and not found (LINES_NOT_FOUND lists them)",
          "properties": { "expected": { "type": "integer" }, "found": { "type": "integer" }, "notFound": { "type": "array", "items": { "type": "string" } } }
        },
        "pages": {
          "type": "object",
          "description": "Every page's outcome: parsed from text, read by OCR, blank, or unreadable (not trusted)",
          "properties": {
            "total": { "type": "integer" },
            "accounted": { "type": "integer" },
            "readable": { "type": "integer" },
            "parsed": { "type": "integer" },
            "ocr": { "type": "integer" },
            "blank": { "type": "integer" },
            "unreadable": { "type": "integer" },
            "notParsed": {
              "type": "array",
              "items": { "type": "object", "properties": { "no": { "type": "integer" }, "state": { "type": "string", "enum": ["OCR", "BLANK", "UNREADABLE"] }, "quality": { "type": "number" } } }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "timingMs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number"
      }
    },
    "usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "legibility": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "ANALYZE: mean page quality (phase 3)"
    },
    "keyPages": {
      "type": "array",
      "description": "ANALYZE and ONBOARD: the pages that matter, found by rules (spec: key pages)",
      "items": {
        "type": "object",
        "required": [
          "role",
          "page"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "PARTIES",
              "DEFINITIONS",
              "FINANCIAL_COVENANTS",
              "COVENANT_CLAUSE",
              "SCHEDULE",
              "AMENDMENT_CLAUSE",
              "BALANCE_SHEET",
              "PROFIT_LOSS",
              "AUDITOR_REPORT",
              "CERTIFICATE_BODY",
              "SIGNATURE"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "quote": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "description": "ANALYZE: page ranges of a bundled PDF (phase 2 rules)",
      "items": {
        "type": "object"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Page-model flags (REPAIRED, TRACKED_CHANGES ...)"
    },
    "commentary": {
      "type": [
        "object",
        "null"
      ],
      "description": "DRAFT_COMMENTARY: draft paragraphs written from the outcome manifest only (phase 4)",
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "restates": {
      "type": ["object", "null"],
      "description": "WP9: an amended and restated agreement; its covenants replace those of versionId once approved",
      "properties": {"versionId": {"type": ["string", "null"]}, "evidence": {"type": "array"}}
    },
    "set": {
      "type": ["object", "null"],
      "description": "RECONCILE_SET (WP9): the documents of the set, in the order applied; missing ones block the set",
      "properties": {
        "setId": {"type": ["string", "null"]},
        "asOfDate": {"type": "string", "format": "date"},
        "documents": {"type": "array", "items": {"type": "object", "properties": {
          "versionId": {"type": "string"}, "role": {"type": "string"}, "effectiveDate": {"type": ["string", "null"]},
          "jobId": {"type": ["string", "null"]}, "applied": {"type": "boolean"}, "reason": {"type": "string"}}}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "notYetEffective": {"type": "array", "items": {"type": "string"}}
      }
    },
    "amendedSet": {
      "type": "array",
      "description": "EXTRACT_AMENDMENT: the covenants as amended (base version with the changes applied)",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "effectiveDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "EXTRACT_AMENDMENT: when the changes take effect"
    },
    "rollout": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SHADOW",
        "ASSISTED",
        "NORMAL",
        null
      ],
      "description": "Phase 7 pilot mode the job ran under"
    }
  }
}
