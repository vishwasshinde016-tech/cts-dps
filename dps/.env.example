# Local development only. Production: DPS_AUTH_MODE=JWT with issuer, audience and JWKS URL.
DPS_DATABASE_URL=sqlite:///./dps.db
DPS_STORAGE_DIR=./storage
DPS_MAX_UPLOAD_MB=50
DPS_AUTH_MODE=DEV_HEADER
# DPS_JWT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# DPS_JWT_AUDIENCE=api://covenant-dps
# DPS_JWT_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
DPS_CORE_BASE_URL=http://localhost:9310
# The Document Agent (CrewAI agent + skills + tools) on the bank's Azure OpenAI deployments. Off unless all three
# are set: DPS_LLM_ENABLED=true, a model (DPS_AI_MODEL or DPS_AI_ROUTES_FILE, see deploy/config/routes.example.yaml)
# and the model host on DPS_AI_ALLOWED_HOSTS. Keys come from the vault: AZURE_API_KEY, AZURE_API_BASE, AZURE_API_VERSION.
# The bank's Azure OpenAI deployment for the demo (everything except the key, which is never in git).
# scripts\setup.ps1 asks for the key once, writes AZURE_API_KEY here and sets DPS_LLM_ENABLED=true.
# By hand: paste the key at the end of the AZURE_API_KEY line and set DPS_LLM_ENABLED to true, then restart the API and the worker.
DPS_LLM_ENABLED=false
DPS_AI_MODEL=azure/gpt-6.1-sol
DPS_AI_ROUTES_FILE=
DPS_AI_ALLOWED_HOSTS=chatbotnl2sql.openai.azure.com
# Longest wait for one model answer, in seconds; a slower answer falls back to the rules answer.
DPS_AI_TIMEOUT_SECONDS=90
AZURE_API_BASE=https://chatbotnl2sql.openai.azure.com/
AZURE_API_VERSION=2025-04-01-preview
AZURE_DEPLOYMENT=gpt-6.1-sol
AZURE_API_KEY=

# Traces (observability): scripts\setup.ps1 -Observability starts Langfuse on this laptop and writes the three OTEL_*
# lines below with the real keys (the service name is set by each process: dps-api, dps-worker, dps-worker-heavy). Without them nothing is traced and nothing is sent. Traces carry ids, counts and
# times; the text sent to the model and its answer go on a trace only with DPS_AI_TRACE_TEXT=true (masked).
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:3000/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic%20<base64 of pk-lf-...:sk-lf-...>,x-langfuse-ingestion-version=4
DPS_AI_TRACE_TEXT=false
